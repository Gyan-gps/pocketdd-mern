PORT=4000
APP_URL=http://localhost:4000
APP_DEBUG=false
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGODB_DB=pocketdd
# Folder holding uploads/ (served at /uploads).
LARAVEL_PUBLIC_PATH=./storage/public
FIREBASE_BASE_PATH=.
FIREBASE_CREDENTIALS=
BCRYPT_ROUNDS=12
SESSION_LIFETIME=120
# Only for scripts/migrate-from-mysql.ts and the Laravel parity tests
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=
DB_PASSWORD=
# Set URL_ROOT when a proxy rewrites Host (Laravel url() root override).
URL_ROOT=
# Run the database queue worker / scheduler inside the API process (set false to run them elsewhere).
QUEUE_WORKER=true
SCHEDULER=true
